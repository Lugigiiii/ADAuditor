<Application x:Class="ADAudit.UI.AuditApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

            <SolidColorBrush x:Key="Fg" Color="#E8EDF3"/>
            <SolidColorBrush x:Key="Fg2" Color="#9AA6B2"/>
            <SolidColorBrush x:Key="Accent" Color="#2DD4BF"/>
            <SolidColorBrush x:Key="Hairline" Color="#26FFFFFF"/>

            <!-- Window tint over the blurred desktop: dark enough to keep text crisp -->
            <LinearGradientBrush x:Key="WindowTint" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D8070D18" Offset="0"/>
                <GradientStop Color="#C80B1524" Offset="0.55"/>
                <GradientStop Color="#D8081220" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2DD4BF" Offset="0"/>
                <GradientStop Color="#6366F1" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#5EEAD4" Offset="0"/>
                <GradientStop Color="#22D3EE" Offset="1"/>
            </LinearGradientBrush>

            <!-- Navigation rail button -->
            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#7F91A6"/>
                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="B" CornerRadius="12" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
                                <Border x:Name="Bar" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0" Background="#2DD4BF" Visibility="Hidden"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#14FFFFFF"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#262DD4BF"/>
                                    <Setter TargetName="B" Property="BorderBrush" Value="#552DD4BF"/>
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="#5EEAD4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented range selector -->
            <Style x:Key="Segment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#9AA6B2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="B" CornerRadius="8" Padding="12,5" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#14FFFFFF"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#332DD4BF"/>
                                    <Setter Property="Foreground" Value="#E8FFFB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="#041A17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="9" Padding="{TemplateBinding Padding}" Background="{StaticResource AccentGradient}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#DDE6F0"/>
            </Style>

            <!-- Frosted glass card -->
            <Style x:Key="GlassPanel" TargetType="Border">
                <Setter Property="Background" Value="#7010192B"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                            <GradientStop Color="#12FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>

            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#7F8B98"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,18,0,6"/>
            </Style>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Read-only, selectable text without chrome -->
            <Style x:Key="SelectableText" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#33FFFFFF"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#14FFFFFF"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#22FFFFFF"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E81123"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Category filter chip; Tag = category colour -->
            <Style x:Key="Chip" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource Fg2}"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="B" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="13" Padding="10,4,12,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{TemplateBinding Tag}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#26FFFFFF"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="B" Property="Background" Value="#332DD4BF"/>
                                    <Setter TargetName="B" Property="BorderBrush" Value="#902DD4BF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Data grid -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="#8E9AA7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border Background="Transparent" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="10,10,10,9">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Sort" FontFamily="{StaticResource Icons}" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="11" Margin="0,0,-5,0" Cursor="SizeWE" ToolTip="Drag to resize">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Rectangle x:Name="Line" Width="1" Margin="0,9" HorizontalAlignment="Center" Fill="#26FFFFFF"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Line" Property="Fill" Value="#2DD4BF"/>
                                                    <Setter TargetName="Line" Property="Width" Value="2"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Line" Property="Fill" Value="#5EEAD4"/>
                                                    <Setter TargetName="Line" Property="Width" Value="2"/>
                                                    <Setter TargetName="Line" Property="Margin" Value="0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="Sort" Property="Text" Value="&#xE70E;"/></Trigger>
                                <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="Sort" Property="Text" Value="&#xE70D;"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Rows: hover tint; selected = teal band with hairlines (stays visible when the grid loses focus) -->
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="BorderThickness" Value="0,1,0,1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#16FFFFFF"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#552DD4BF" Offset="0"/>
                                    <GradientStop Color="#262DD4BF" Offset="0.6"/>
                                    <GradientStop Color="#142DD4BF" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="#802DD4BF"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="10,7" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
