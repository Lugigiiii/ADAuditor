<Window x:Class="ADAudit.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD Audit Trail – Settings" Icon="/ADAudit;component/Assets/app.ico"
        Width="860" Height="820" MinHeight="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="Transparent" Foreground="{StaticResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowTint}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="22,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#5EEAD4" VerticalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Cancel_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,4,22,10">

                <!-- ───────── group rules ───────── -->
                <TextBlock Text="Group alerts" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TitleGradient}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" Margin="0,4,0,14"
                           Text="When someone is added to one of these groups, AD Audit can raise an alert, ask for an acknowledgment and/or remove the new member again after a set time. Rules apply to changes made on any domain controller."/>

                <Border Style="{StaticResource GlassPanel}" Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GROUP" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Grid.Column="1" Text="ALERT" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Grid.Column="2" Text="ACKNOWLEDGE" Style="{StaticResource SectionLabel}" Margin="0"
                                       ToolTip="Alerts stay open until someone acknowledges them with a reason. Acknowledged memberships do not alert again."/>
                            <TextBlock Grid.Column="3" Text="REMOVE NEW MEMBER" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Grid.Column="4" Text="AFTER (MIN)" Style="{StaticResource SectionLabel}" Margin="0"/>
                        </Grid>
                        <ItemsControl x:Name="RulesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditVisibility}"
                                                         ToolTip="sAMAccountName or name of the group"/>
                                                <StackPanel Visibility="{Binding BuiltInVisibility}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BuiltInHint}" Foreground="{StaticResource Fg2}" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding Alert}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding RequireAck}" VerticalAlignment="Center" Content="{Binding AckText}"/>
                                            <CheckBox Grid.Column="3" IsChecked="{Binding AutoRemove}" VerticalAlignment="Center" Content="{Binding RemoveText}"/>
                                            <TextBox Grid.Column="4" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding AutoRemove}"
                                                     Width="80" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Style="{StaticResource CaptionButton}" Width="32" Height="32" FontSize="12"
                                                    Content="&#xE74D;" ToolTip="Remove this rule" Tag="{Binding}" Click="Delete_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GlassButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Add_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Add group"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ───────── acknowledged memberships ───────── -->
                <TextBlock Text="Acknowledged memberships" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,0,0,8"
                           Text="These members were confirmed as intended and do not raise alerts. Revoke an acknowledgment to be alerted again the next time this person is added. Revoking is recorded in the audit trail."/>
                <Border Style="{StaticResource GlassPanel}" Padding="16,8">
                    <StackPanel>
                        <TextBlock x:Name="NoAcks" Text="No acknowledged memberships yet." Foreground="{StaticResource Fg2}" Margin="0,6"/>
                        <ItemsControl x:Name="AcksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding MemberDn}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GroupName}" Foreground="#5EEAD4" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Fg2}" FontSize="11"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{StaticResource GlassButton}" Content="Revoke" Tag="{Binding Id}" Click="Revoke_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ───────── notifications ───────── -->
                <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,8"/>
                <Border Style="{StaticResource GlassPanel}" Padding="16,12">
                    <StackPanel>
                        <CheckBox x:Name="PopupBox" Content="Show a pop-up in every session on the domain controller"/>
                        <TextBlock Text="Alerts are always written to the Windows Application log (source ADAudit, ID 1001) and shown in every open viewer."
                                   Foreground="{StaticResource Fg2}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <TextBlock Text="E-MAIL" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Mail server" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
                            <TextBox x:Name="SmtpHost" Grid.Column="1" ToolTip="e.g. smtp.office365.com or mail.example.com"/>
                            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0,8,0" Foreground="{StaticResource Fg2}"/>
                            <TextBox x:Name="SmtpPort" Grid.Column="3" ToolTip="25 (plain), 587 (STARTTLS) or 465"/>
                            <CheckBox x:Name="SmtpSsl" Grid.Column="4" Content="TLS" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Use TLS / STARTTLS (normally with port 587)"/>

                            <TextBlock Grid.Row="1" Text="User name" VerticalAlignment="Center" Foreground="{StaticResource Fg2}" Margin="0,8,0,0"/>
                            <TextBox x:Name="SmtpUser" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,0" ToolTip="Leave empty if the server does not require a login"/>

                            <TextBlock Grid.Row="2" Text="Password" VerticalAlignment="Center" Foreground="{StaticResource Fg2}" Margin="0,8,0,0"/>
                            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,0">
                                <PasswordBox x:Name="SmtpPassword" ToolTip="Stored encrypted on the domain controller; never shown again"/>
                                <TextBlock x:Name="PwHint" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#6E7A86"/>
                            </Grid>
                            <CheckBox x:Name="ClearPw" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,0,0" Content="Remove stored password" Visibility="Collapsed"/>

                            <TextBlock Grid.Row="4" Text="Sender" VerticalAlignment="Center" Foreground="{StaticResource Fg2}" Margin="0,8,0,0"/>
                            <TextBox x:Name="SmtpFrom" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,8,0,0" ToolTip="From address (defaults to the user name)"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Recipients" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
                            <TextBox x:Name="SmtpTo" Grid.Column="1" ToolTip="Several recipients separated by ; or ,"/>
                            <Button x:Name="TestBtn" Grid.Column="2" Style="{StaticResource GlassButton}" Margin="8,0,0,0" Click="Test_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Send test mail"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="TestMsg" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#33000000" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <TextBlock x:Name="Msg" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,260,0" Foreground="{StaticResource Fg2}" FontSize="12"
                           Text="Saved on the domain controller and applied immediately. Every change is recorded in the audit trail."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GlassButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource PrimaryButton}" Content="Save" Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
