<Window x:Class="ADAudit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ADAudit.UI"
        Title="AD Audit Trail" Icon="/ADAudit;component/Assets/app.ico" Width="1680" Height="980" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        Foreground="{StaticResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource WindowTint}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────── Navigation rail ───────── -->
        <Border Background="#40050A12" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="0,12,0,14">
                <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentGradient}" Margin="0,0,0,22">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="#05201C"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <RadioButton x:Name="NavDashboard" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True"
                             Content="&#xE80F;" ToolTip="Dashboard" Checked="Nav_Checked" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <RadioButton x:Name="NavLog" DockPanel.Dock="Top" Style="{StaticResource NavButton}" GroupName="nav"
                             Content="&#xE8FD;" ToolTip="Audit log" Checked="Nav_Checked" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource CaptionButton}" FontSize="16" Width="46" Height="46"
                        Content="&#xE703;" ToolTip="Connection / switch domain controller" Click="ShowConnect_Click"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource CaptionButton}" FontSize="16" Width="46" Height="46" Margin="0,0,0,6"
                        Content="&#xE713;" ToolTip="Settings: group alerts and automatic removal" Click="Settings_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ───────── Top bar ───────── -->
            <Grid Grid.Row="0" Margin="20,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AD Audit Trail" FontSize="13" FontWeight="SemiBold" Foreground="#C9D4E0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HostText" Foreground="{StaticResource Fg2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="DemoBadge" Visibility="Collapsed" Margin="12,0,0,0" Padding="8,2" CornerRadius="6" Background="#40D29922" VerticalAlignment="Center">
                        <TextBlock Text="DEMO DATA" FontSize="11" FontWeight="Bold" Foreground="#F2CC60"/>
                    </Border>
                </StackPanel>
                <ItemsControl x:Name="Pills" Grid.Column="2" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6,0,0,0" Padding="10,4" CornerRadius="13" Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" ToolTip="{Binding Tip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Fg2}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ───────── Banners: errors / initialization / FS_Admin guard ───────── -->
            <StackPanel Grid.Row="1" Margin="20,4,20,0">
                <Border x:Name="ErrorBanner" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                        Background="#66F85149" BorderBrush="#AAF85149" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE783;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="InitBanner" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Margin="0,0,0,6"
                        Background="#332DD4BF" BorderBrush="#802DD4BF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Initializing — importing past events. Entries appear as they are found; live monitoring is already active." FontWeight="SemiBold"/>
                            <TextBlock x:Name="InitText" Foreground="#B5F5EA" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="InitProgress" Grid.Column="2" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="GuardList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="14,9" Margin="0,0,0,6" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Countdown}" FontFamily="{StaticResource Mono}" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="16,0"/>
                                    <Button Grid.Column="3" Style="{StaticResource GlassButton}" Content="Show entry" Tag="{Binding AuditId}" Click="GuardShow_Click"/>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,6" Visibility="{Binding AckVisibility}"
                                            Click="Ack_Click" ToolTip="Confirm that this membership is intended (with a reason). It will not alert again.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Acknowledge"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═════════════ DASHBOARD ═════════════ -->
            <Grid x:Name="DashboardPage" Grid.Row="2" Margin="20,6,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.05*" MinHeight="230"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Audit Overview" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TitleGradient}"/>
                        <TextBlock x:Name="DashSubtitle" Foreground="{StaticResource Fg2}" Margin="2,2,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="drange" Content="24 h" Tag="1" Checked="DashRange_Checked"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="drange" Content="7 days" Tag="7" Checked="DashRange_Checked"/>
                            <RadioButton x:Name="DashDefault" Style="{StaticResource Segment}" GroupName="drange" Content="30 days" Tag="30" Checked="DashRange_Checked"/>
                            <RadioButton Style="{StaticResource Segment}" GroupName="drange" Content="6 months" Tag="183" Checked="DashRange_Checked"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- stat cards -->
                <UniformGrid Grid.Row="1" Rows="1" Margin="-6,0,-6,12">
                    <Border Style="{StaticResource GlassPanel}" Margin="6,0" Padding="18,14,18,10">
                        <StackPanel>
                            <TextBlock Text="Directory changes" Foreground="{StaticResource Fg2}"/>
                            <TextBlock x:Name="StatChanges" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#5EEAD4" Margin="0,4,0,0"/>
                            <ui:AreaChart x:Name="SparkChanges" Sparkline="True" Height="34" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassPanel}" Margin="6,0" Padding="18,14,18,10">
                        <StackPanel>
                            <TextBlock Text="Group membership" Foreground="{StaticResource Fg2}"/>
                            <TextBlock x:Name="StatMembership" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#67E8F9" Margin="0,4,0,0"/>
                            <TextBlock x:Name="StatMembershipSub" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassPanel}" Margin="6,0" Padding="18,14,18,10">
                        <StackPanel>
                            <TextBlock Text="Created / deleted" Foreground="{StaticResource Fg2}"/>
                            <TextBlock x:Name="StatCreated" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,4,0,0"/>
                            <TextBlock Text="objects" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassPanel}" Margin="6,0" Padding="18,14,18,10">
                        <StackPanel>
                            <TextBlock Text="Reverted" Foreground="{StaticResource Fg2}"/>
                            <TextBlock x:Name="StatReverted" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#FCD34D" Margin="0,4,0,0"/>
                            <TextBlock Text="changes undone later" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassPanel}" Margin="6,0" Padding="18,14,18,10">
                        <StackPanel>
                            <TextBlock Text="Security events" Foreground="{StaticResource Fg2}"/>
                            <TextBlock x:Name="StatSecurity" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#F9A8D4" Margin="0,4,0,0"/>
                            <ui:AreaChart x:Name="SparkSecurity" Sparkline="True" Height="34" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AlertCard" Style="{StaticResource GlassPanel}" Margin="6,0" Padding="18,14,18,10">
                        <StackPanel>
                            <TextBlock Text="Alerts / tampering" Foreground="{StaticResource Fg2}"/>
                            <TextBlock x:Name="StatAlerts" Text="–" FontSize="30" FontWeight="SemiBold" Foreground="#FCA5A5" Margin="0,4,0,0"/>
                            <TextBlock x:Name="StatAlertsSub" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- charts -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="330"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GlassPanel}" Padding="18,14">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Activity" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="8" Height="8" Fill="#2DD4BF" VerticalAlignment="Center"/>
                                    <TextBlock Text="Directory changes" Foreground="{StaticResource Fg2}" FontSize="12" Margin="6,0,16,0"/>
                                    <Ellipse Width="8" Height="8" Fill="#8B5CF6" VerticalAlignment="Center"/>
                                    <TextBlock Text="Security events" Foreground="{StaticResource Fg2}" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ui:AreaChart x:Name="ActivityChart" NameA="Changes" NameB="Security"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="18,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="By category" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:DonutChart x:Name="Donut" MinWidth="140"/>
                                <ItemsControl x:Name="DonutLegend" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Fg2}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- similar events, grouped -->
                <Border Grid.Row="3" Style="{StaticResource GlassPanel}" Padding="18,14,18,6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Similar events, grouped" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="same action by the same person — double-click to open the individual entries in the log"
                                           Foreground="#6E7A86" FontSize="12" Margin="12,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid HorizontalAlignment="Right" Width="320">
                                <TextBox x:Name="GroupFilter" Padding="30,5,8,5" TextChanged="GroupFilter_TextChanged"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="GroupFilterHint" Text="Filter groups: person, action, object…" Foreground="#6E7A86" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                        <DataGrid x:Name="Groups" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#10FFFFFF" Background="Transparent" RowBackground="Transparent"
                                  BorderThickness="0" CanUserAddRows="False" EnableRowVirtualization="True" VirtualizingPanel.ScrollUnit="Pixel"
                                  MouseDoubleClick="Groups_DoubleClick" KeyDown="Groups_KeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="6" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Border Width="4" Height="18" CornerRadius="2" Background="{Binding CategoryColor}" ToolTip="{Binding Category}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Count" Width="74" SortMemberPath="Count">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#1F2DD4BF" CornerRadius="9" Padding="8,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" Foreground="#5EEAD4"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="210" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Who" Binding="{Binding Actor}" Width="190" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Objects" Binding="{Binding TargetText}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="When" Binding="{Binding Span}" Width="130" SortMemberPath="LastUtc" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Reverted" Width="90" SortMemberPath="Reverted">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding RevertedText}" Foreground="#FCD34D" FontWeight="SemiBold" Style="{StaticResource CellText}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ═════════════ AUDIT LOG ═════════════ -->
            <Grid x:Name="LogPage" Grid.Row="2" Visibility="Collapsed" Margin="20,6,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Audit Log" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TitleGradient}" Margin="0,0,0,12"/>

                <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,0,0,10" Padding="12,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SearchBox" Padding="34,7,10,7" FontSize="14" VerticalContentAlignment="Center"
                                         TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Fg2}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="SearchHint" IsHitTestVisible="False" VerticalAlignment="Center" Margin="36,0,0,0" Foreground="#6E7A86"
                                           Text="Search everything: user, group, DN, attribute, value, IP, host…   (-word excludes · #123 jumps to entry)"/>
                            </Grid>
                            <ComboBox x:Name="RangeBox" Grid.Column="1" Width="160" Margin="10,0,0,0" SelectionChanged="Range_Changed">
                                <ComboBoxItem Content="Last hour"/>
                                <ComboBoxItem Content="Last 24 hours"/>
                                <ComboBoxItem Content="Last 7 days"/>
                                <ComboBoxItem Content="Last 30 days"/>
                                <ComboBoxItem Content="Last 6 months"/>
                                <ComboBoxItem Content="Everything"/>
                                <ComboBoxItem Content="Custom range…"/>
                            </ComboBox>
                            <StackPanel x:Name="CustomPanel" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" Margin="10,0,0,0">
                                <DatePicker x:Name="FromDate" Width="130" SelectedDateChanged="Custom_Changed"/>
                                <TextBox x:Name="FromTime" Width="64" Margin="4,0,0,0" Text="00:00" LostFocus="Custom_LostFocus" ToolTip="From time (HH:mm)"/>
                                <TextBlock Text="→" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource Fg2}"/>
                                <DatePicker x:Name="ToDate" Width="130" SelectedDateChanged="Custom_Changed"/>
                                <TextBox x:Name="ToTime" Width="64" Margin="4,0,0,0" Text="23:59" LostFocus="Custom_LostFocus" ToolTip="To time (HH:mm)"/>
                            </StackPanel>
                            <ComboBox x:Name="DcBox" Grid.Column="3" Width="130" Margin="10,0,0,0" SelectionChanged="Filter_Changed" ToolTip="Domain controller where the change was made"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="RevertedOnly" Content="Reverted only" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"/>
                                <CheckBox x:Name="NoiseBox" Content="System noise" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,10,0"
                                          ToolTip="Also show automatic background changes (computers updating their own SPN / DNS name / OS version, dynamic DNS) stored before the noise filter existed"/>
                                <CheckBox x:Name="LiveBox" Content="Live" IsChecked="True" ToolTip="Show new entries automatically"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Style="{StaticResource GlassButton}" Click="Refresh_Click" ToolTip="Refresh (F5)">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}"/>
                                </Button>
                                <Button Style="{StaticResource GlassButton}" Margin="6,0,0,0" Click="Export_Click" ToolTip="Export all matching entries to CSV">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Export"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="VerifyBtn" Style="{StaticResource GlassButton}" Margin="6,0,0,0" Click="Verify_Click" ToolTip="Recompute the complete tamper-evident hash chain">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Verify"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="Chips" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="500"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="400" MinWidth="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GlassPanel}" ClipToBounds="True">
                        <Grid>
                        <DataGrid x:Name="Results" FrozenColumnCount="1" CanUserResizeColumns="True" CanUserReorderColumns="True" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#10FFFFFF"
                                  Background="Transparent" RowBackground="Transparent" BorderThickness="0" Margin="4,2,4,4"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" ClipboardCopyMode="IncludeHeader"
                                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                  SelectionChanged="Results_SelectionChanged">
                            <DataGrid.Columns>
                                <!-- timeline: coloured trail + node per event; revert connectors are drawn by LinkCanvas -->
                                <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell"><ContentPresenter/></ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="48" Background="Transparent" ToolTip="{Binding Category}">
                                                <Rectangle Width="2" HorizontalAlignment="Left" Margin="13,0,0,0" Fill="{Binding CategoryColor}" Opacity="0.42"/>
                                                <Ellipse x:Name="Ring" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5.5,0,0,0"
                                                         Stroke="#5EEAD4" StrokeThickness="2" Visibility="Hidden"/>
                                                <Ellipse x:Name="Dot" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9.5,0,0,0"
                                                         Fill="{Binding CategoryColor}" Stroke="#0B1220" StrokeThickness="1.5"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsReconstructed}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="#0B1220"/>
                                                    <Setter TargetName="Dot" Property="Stroke" Value="{Binding CategoryColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="When" Binding="{Binding WhenLocal}" Width="158" SortMemberPath="TimeUtc" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Who" Binding="{Binding Actor}" Width="170" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="185" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Target" Width="160" SortMemberPath="TargetName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding TargetName}" ToolTip="{Binding TargetDn}" Style="{StaticResource CellText}" FontWeight="SemiBold"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="What changed" Binding="{Binding Change}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="From where" Binding="{Binding Where}" Width="175" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="DC" Binding="{Binding Dc}" Width="115" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Revert" Width="128" SortMemberPath="RevertBadge">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding RevertBadge}" Foreground="{Binding RevertColor}" FontWeight="SemiBold" Style="{StaticResource CellText}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Canvas x:Name="LinkCanvas" Margin="4,2,4,4" IsHitTestVisible="False" HorizontalAlignment="Left" Width="60"/>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
                    <Border Grid.Column="2" Style="{StaticResource GlassPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Detail" Margin="20,16,20,20"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Fg2}" VerticalAlignment="Center"/>
                    <Button x:Name="MoreBtn" Grid.Column="1" Style="{StaticResource GlassButton}" Padding="10,2" Margin="12,0,0,0" Content="Load older entries"
                            Visibility="Collapsed" Click="More_Click" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Foreground="#6E7A86" VerticalAlignment="Center"
                               Text="Ctrl+F search · F5 refresh · Esc clear · Ctrl+C copy row · read-only: the trail cannot be edited"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════════ CONNECT OVERLAY ═════════════ -->
        <Grid x:Name="ConnectOverlay" Grid.ColumnSpan="2" Background="#B3050A12" Visibility="Collapsed">
            <Border Style="{StaticResource GlassPanel}" Background="#E00E1828" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Connect to the audit service" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleGradient}"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" Margin="0,8,0,16"
                               Text="This viewer stores no audit data. It reads the audit trail live from the AD Audit service on a domain controller, using Kerberos over SMB (port 445). Your account needs administrator rights on the domain controllers, e.g. Domain Admins."/>
                    <TextBlock Text="Domain controller" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ServerBox" IsEditable="True"/>
                    <TextBlock x:Name="CurrentUserText" Foreground="#6E7A86" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock x:Name="ConnectMsg" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#FCA5A5" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="ConnectCancel" Style="{StaticResource GlassButton}" Content="Cancel" Click="ConnectCancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ConnectAltBtn" Style="{StaticResource GlassButton}" Content="Use other credentials…" Click="ConnectAlt_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ConnectBtn" Style="{StaticResource PrimaryButton}" Content="Connect" Click="Connect_Click" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
