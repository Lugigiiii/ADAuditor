<Window x:Class="ADAudit.UI.AckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acknowledge membership" Icon="/ADAudit;component/Assets/app.ico"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="Transparent" Foreground="{StaticResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowTint}" Padding="24,18,24,20">
        <StackPanel>
            <TextBlock Text="Acknowledge membership" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TitleGradient}"/>
            <TextBlock x:Name="Info" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,8,0,14"
                       Text="Acknowledging confirms that this membership is intended. It will not raise an alert again for this person in this group (until the acknowledgment is revoked in Settings). Your name, the time and the reason are recorded in the audit trail."/>
            <TextBlock Text="Reason (required)" Foreground="{StaticResource Fg2}" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="Reason" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     TextChanged="Reason_TextChanged"/>
            <TextBlock x:Name="Msg" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource GlassButton}" Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" Content="Acknowledge" IsEnabled="False" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
